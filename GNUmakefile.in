	$(AM_V_GEN)cp -f $< $@

$(top_builddir)/DerivedSources/webkitdom/WebKitDOMEventTarget.symbols: $(WebCore)/bindings/gobject/WebKitDOMEventTarget.symbols
	$(AM_V_GEN)cp -f $< $@

